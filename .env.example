# Copy this file to `.env` and fill in your Supabase project's values to enable
# ONLINE (multiplayer) mode. Leave them unset to run in local-only mode.
#
# Find these in your Supabase dashboard under: Project Settings → API.
# The anon key is a public, browser-safe key — it's fine to ship in the app.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
